{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$CLAUDE_PROJECT_DIR/.claude/hooks/image_read.py\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$CLAUDE_PROJECT_DIR/.claude/hooks/emu_run.py\""
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Artifact",
      "ScheduleWakeup",
      "SendFeedback",
      "ReportFindings",
      "EnterWorktree"
    ]
  },
  "enabledPlugins": {
    "frontend-design@anthropic-plugin-directory": false,
    "engineering@anthropic-plugin-directory": false,
    "rust-analyzer-lsp@claude-plugins-official": true
  }
}
